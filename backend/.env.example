# Exemplo de .env para desenvolvimento
# Substitua os valores abaixo pelos do seu banco Postgre
# Formato de URL aceito pelo Prisma:
# postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO

DATABASE_URL="postgresql://seu_usuario:suasenha@localhost:5432/webaudit_db"

# Se você usar SSL (ex: host cloud), ajuste conforme necessário
# DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"
